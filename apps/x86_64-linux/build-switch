#!/bin/sh -e

VERSION=1.0

GREEN='\033[1;32m'
RED='\033[1;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

SYSTEM=$(uname -m)

case "$SYSTEM" in
  x86_64)
    FLAKE_TARGET="x86_64-linux"
    ;;
  aarch64)
    FLAKE_TARGET="aarch64-linux"
    ;;
  *)
    echo -e "${RED}Unsupported architecture: $SYSTEM${NC}"
    exit 1
    ;;
esac

# These two hosts opt in to personal Rex; other machines keep their profile.
case "$SYSTEM:$(hostname -s)" in
  x86_64:black) FLAKE_TARGET="black" ;;
  x86_64:scholes) FLAKE_TARGET="scholes" ;;
esac

echo -e "${YELLOW}Starting...${NC}"

nix run ".#homeConfigurations.$FLAKE_TARGET.activationPackage" "$@"

echo -e "${GREEN}Switch to new generation complete!${NC}"
